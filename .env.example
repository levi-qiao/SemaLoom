# Copy to .env locally. T00 identity launch does not require this file.
# Do not put real business credentials or production secrets here.

SEMALOOM_PROFILE=local-dev

# Used by compose.yaml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=semaloom_dev
POSTGRES_USER=semaloom
POSTGRES_PASSWORD=semaloom

# Physical environment bindings. Each logical source may use a different URL.
# The checked-in values are synthetic local fixtures only.
SEMALOOM_TAX_DATABASE_URL=postgresql+psycopg://semaloom:semaloom@127.0.0.1:5432/semaloom_tax
SEMALOOM_ORDERS_DATABASE_URL=postgresql+psycopg://semaloom:semaloom@127.0.0.1:5432/semaloom_orders
SEMALOOM_SUPPLIERS_DATABASE_URL=postgresql+psycopg://semaloom:semaloom@127.0.0.1:5432/semaloom_suppliers
SEMALOOM_META_DATABASE_URL=postgresql+psycopg://semaloom:semaloom@127.0.0.1:5432/semaloom_meta

# Optional Studio Chat decision hook. Keep real keys in the process environment,
# a local untracked secret store, or your deployment secret manager.
# TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
SEMALOOM_JEV_MODE=shadow
SEMALOOM_JEV_MIN_CONFIDENCE=0.85
