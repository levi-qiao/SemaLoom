            "explanation": "已发布样本中的 2025 申报年度",
            "choice": {
              "kind": "YEAR",
              "id": "2025",
              "field": "finance.TaxReturn.taxYear"
            }
          },
          {
            "id": "opt_other_input",
            "label": "其他",
            "explanation": "用一句话补充年份、口径或对象，系统按原问题继续，不要求手打候选名称",
            "choice": {"kind": "OTHER", "id": "free_text"}
          },
          {
            "id": "opt_year_unclear",
            "label": "都不符合 / 暂不清楚",
            "explanation": "停止本次计算，不默认最近一年",
            "choice": {"kind": "ABORT", "id": "unclear"}
          }
        ]
      }
    },
    "submit": {
      "questionId": "q-year-1",
      "revision": 1,
      "optionIds": ["opt_year_2024"]
    }
