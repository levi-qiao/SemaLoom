          },
          {
            "id": "opt_taxable_income",
            "label": "申报应纳税所得额",
            "explanation": "计算所得税采用的所得额",
            "choice": {"kind": "METRIC", "id": "finance.taxableIncome"}
          },
          {
            "id": "opt_other_input",
            "label": "其他",
            "explanation": "用一句话补充年份、口径或对象，系统按原问题继续，不要求手打候选名称",
            "choice": {"kind": "OTHER", "id": "free_text"}
          },
          {
            "id": "opt_unclear",
            "label": "都不符合 / 暂不清楚",
            "explanation": "停止本次计算，不猜测口径",
            "choice": {"kind": "ABORT", "id": "unclear"}
          }
        ]
      }
    },
    "submit": {
      "questionId": "q-metric-1",
      "revision": 1,
      "optionIds": ["opt_declared_revenue"]
    }
  },
