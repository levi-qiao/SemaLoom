        "questionId": "q-metric-1",
        "revision": 1,
        "slot": "metric",
        "prompt": "你说的收入是哪种口径？",
        "reason": "本体中有多个收入相关指标，口径会改变结果。",
        "multiSelect": false,
        "options": [
          {
            "id": "opt_declared_revenue",
            "label": "申报营业收入",
