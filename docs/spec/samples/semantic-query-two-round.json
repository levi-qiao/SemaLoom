{
  "apiVersion": "semaloom/v0.1",
  "kind": "SemanticQueryContractSample",
  "id": "two-round-choice-then-compute",
  "description": "Vague metric then missing year: two NEEDS_INPUT rounds, option-id submits, then READY. Abort and error shapes are included for the parser, not as a successful path.",
  "initialQuery": {
    "apiVersion": "semaloom/v0.1",
    "metrics": [],
